APP_ENV=local
LOCAL_DEV_ROUTES_ENABLED=true
LOCAL_INBOUND_AUTOREPLY_ENABLED=true
INBOUND_AUTOREPLY_ENABLED=true

AI_MODE=groq
AI_TEMPERATURE=0.4
AI_REQUEST_TIMEOUT_MS=30000
AI_RECENT_MESSAGE_LIMIT=12
OPENAI_MAX_OUTPUT_TOKENS=1200
AI_DEBUG_RESPONSE=false

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TRANSCRIPTION_ENABLED=true
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIPTION_LANGUAGE=pt
GROQ_TRANSCRIPTION_TIMEOUT_MS=30000
GROQ_TRANSCRIPTION_MAX_BYTES=24000000

AI_RATE_LIMIT_GUARD_ENABLED=true
AI_MIN_REQUEST_INTERVAL_MS=8000
AI_RATE_LIMIT_MAX_RETRIES=1
WHATSAPP_INBOUND_BUFFER_MS=3000

OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

UAZAPI_BASE_URL=https://your-uazapi-host.example
UAZAPI_TOKEN=your-uazapi-token
UAZAPI_OUTBOUND_ENABLED=false
UAZAPI_DEBUG_PAYLOAD=false
UAZAPI_REQUEST_TIMEOUT_MS=30000

TEST_WHATSAPP_NUMBER=5511000000000
TEST_ERROR_ALERT_ENABLED=false
TEST_ERROR_ALERT_NUMBER=5511000000000
TEST_ERROR_ALERT_COOLDOWN_SECONDS=60

LOG_LEVEL=debug
LOG_MESSAGE_CONTENT=false
WEBHOOK_AUTH_MODE=off
WEBHOOK_SECRET=your-webhook-secret
ADMIN_API_KEY=your-admin-api-key
