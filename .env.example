APP_ENV=local

AI_MODE=openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

AI_TEMPERATURE=0.4
AI_REQUEST_TIMEOUT_MS=30000
AI_RATE_LIMIT_GUARD_ENABLED=true
AI_MIN_REQUEST_INTERVAL_MS=8000
AI_RATE_LIMIT_MAX_RETRIES=1
WHATSAPP_INBOUND_BUFFER_MS=3000
AI_DEBUG_RESPONSE=false
AI_RECENT_MESSAGE_LIMIT=12
OPENAI_MAX_OUTPUT_TOKENS=800

UAZAPI_BASE_URL=
UAZAPI_TOKEN=
UAZAPI_OUTBOUND_ENABLED=false
UAZAPI_DEBUG_PAYLOAD=true
UAZAPI_REQUEST_TIMEOUT_MS=30000
TEST_WHATSAPP_NUMBER=

LOCAL_DEV_ROUTES_ENABLED=true
LOCAL_INBOUND_AUTOREPLY_ENABLED=false
# Local development-only gate. Production inbound webhooks use INBOUND_AUTOREPLY_ENABLED.
INBOUND_AUTOREPLY_ENABLED=false

LOG_LEVEL=debug
LOG_MESSAGE_CONTENT=false
WEBHOOK_AUTH_MODE=off
ADMIN_API_KEY=

TEST_ERROR_ALERT_ENABLED=true
TEST_ERROR_ALERT_NUMBER=5511976388220
TEST_ERROR_ALERT_COOLDOWN_SECONDS=60
