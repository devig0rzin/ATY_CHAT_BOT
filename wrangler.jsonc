{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aty-chat-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "vars": {
    "APP_ENV": "production",
    "AI_MODE": "groq",
    "GROQ_MODEL": "openai/gpt-oss-20b",
    "GROQ_BASE_URL": "https://api.groq.com/openai/v1",
    "GROQ_TRANSCRIPTION_ENABLED": "true",
    "GROQ_TRANSCRIPTION_MODEL": "whisper-large-v3-turbo",
    "GROQ_TRANSCRIPTION_LANGUAGE": "pt",
    "GROQ_TRANSCRIPTION_TIMEOUT_MS": "30000",
    "GROQ_TRANSCRIPTION_MAX_BYTES": "24000000",
    "GROQ_VISION_ENABLED": "true",
    "GROQ_VISION_MODEL": "qwen/qwen3.8-27b",
    "GROQ_VISION_MAX_BYTES": "20000000",
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "OPENROUTER_MODEL": "openrouter/free",
    "AI_TEMPERATURE": "0.4",
    "AI_REQUEST_TIMEOUT_MS": "30000",
    "AI_RATE_LIMIT_GUARD_ENABLED": "true",
    "AI_MIN_REQUEST_INTERVAL_MS": "8000",
    "AI_RATE_LIMIT_MAX_RETRIES": "1",
    "WHATSAPP_INBOUND_BUFFER_MS": "3000",
    "INBOUND_AUTOREPLY_ENABLED": "true",
    "UAZAPI_BASE_URL": "https://automationtoyou.uazapi.com",
    "UAZAPI_OUTBOUND_ENABLED": "true",
    "UAZAPI_DEBUG_PAYLOAD": "false",
    "UAZAPI_REQUEST_TIMEOUT_MS": "30000",
    "WEBHOOK_AUTH_MODE": "off",
    "LOG_LEVEL": "info",
    "LOG_MESSAGE_CONTENT": "false",
    "LOCAL_DEV_ROUTES_ENABLED": "false",
    "LOCAL_INBOUND_AUTOREPLY_ENABLED": "false",
    "AI_RECENT_MESSAGE_LIMIT": "12",
    "OPENAI_MAX_OUTPUT_TOKENS": "1200",
    "AI_DEBUG_RESPONSE": "false",
    "WHATSAPP_REPLY_SOFT_LIMIT": "280",
    "WHATSAPP_REPLY_MAX_CHUNKS": "2",
    "TEST_ERROR_ALERT_ENABLED": "true",
    "TEST_ERROR_ALERT_NUMBER": "5511976388220",
    "TEST_ERROR_ALERT_COOLDOWN_SECONDS": "60"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aty-whatsapp-agent-db",
      "database_id": "1cde5f3e-8c54-4a4f-aed7-a1d1944ede05"
    }
  ]
}
