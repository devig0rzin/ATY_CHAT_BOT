{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aty-chat-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "vars": {
    "AI_MODE": "mock",
    "WEBHOOK_AUTH_MODE": "off",
    "ADMIN_API_KEY": "change-me-local",
    "LOG_LEVEL": "debug",
    "LOG_MESSAGE_CONTENT": "false",
    "AI_RECENT_MESSAGE_LIMIT": "12",
    "OPENAI_MAX_OUTPUT_TOKENS": "600"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aty-whatsapp-agent-db",
      "database_id": "1cde5f3e-8c54-4a4f-aed7-a1d1944ede05"
    }
  ]
}
